{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ASPPIBRA DevOS",
  "version": "0.1.0",
  "identifier": "org.asppibra.devos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080/dev",
    "beforeDevCommand": "pnpm run dev --port 8080",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ASPPIBRA DevOS — Mission Control",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self';",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://localhost:8080 http://localhost:8080;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
